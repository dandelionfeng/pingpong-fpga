# Source packages omit SDKs. Reuse setup_windows.ps1's installation in this
# checkout or a parent checkout; explicit package paths retain priority.
include_guard(GLOBAL)
set(PIPELINE_DEPENDENCIES_ROOT "" CACHE PATH "Checkout containing the Windows .tools dependencies")
if(NOT WIN32)
  return()
endif()

set(_pipeline_dependency_roots)
if(PIPELINE_DEPENDENCIES_ROOT)
  list(APPEND _pipeline_dependency_roots "${PIPELINE_DEPENDENCIES_ROOT}")
endif()
set(_pipeline_parent "${PROJECT_SOURCE_DIR}")
while(TRUE)
  list(APPEND _pipeline_dependency_roots "${_pipeline_parent}")
  get_filename_component(_pipeline_next_parent "${_pipeline_parent}" DIRECTORY)
  if(_pipeline_next_parent STREQUAL _pipeline_parent)
    break()
  endif()
  set(_pipeline_parent "${_pipeline_next_parent}")
endwhile()
list(REMOVE_DUPLICATES _pipeline_dependency_roots)

foreach(_pipeline_root IN LISTS _pipeline_dependency_roots)
  set(_pipeline_cv "${_pipeline_root}/.tools/opencv413/opencv/build")
  set(_pipeline_qt "${_pipeline_root}/.tools/qt/6.8.3/msvc2022_64")
  if(EXISTS "${_pipeline_cv}/OpenCVConfig.cmake")
    list(APPEND CMAKE_PREFIX_PATH "${_pipeline_cv}")
  endif()
  if(EXISTS "${_pipeline_qt}/lib/cmake/Qt6/Qt6Config.cmake")
    list(APPEND CMAKE_PREFIX_PATH "${_pipeline_qt}")
  endif()
endforeach()
