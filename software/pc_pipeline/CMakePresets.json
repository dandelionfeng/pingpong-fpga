{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / MSVC 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../../build/a_pipeline_vscode",
      "cacheVariables": {
        "PIPELINE_BUILD_GUI": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "jobs": 4 },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
