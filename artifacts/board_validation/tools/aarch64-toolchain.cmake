set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER /tmp/arm64-root/usr/bin/aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER /tmp/arm64-root/usr/bin/aarch64-linux-gnu-g++)
set(CMAKE_SYSROOT /tmp/arm64-root)
set(CMAKE_FIND_ROOT_PATH /tmp/arm64-root)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "--sysroot=/tmp/arm64-root -march=armv8-a+simd")
set(CMAKE_CXX_FLAGS_INIT "--sysroot=/tmp/arm64-root -march=armv8-a+simd")
